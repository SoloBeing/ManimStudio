#!/bin/sh
# postrm — runs after the package is removed/purged. Refreshes the desktop and
# icon caches so the launcher disappears. User data in ~/ManimStudio (renders,
# recent_renders.json, latex_warned) is intentionally left untouched.
set -e

case "$1" in
  remove|purge)
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi
    ;;
esac

exit 0
